<ui version="4.0">
 <class>frame</class>
 <widget class="QFrame" name="frame">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>860</width>
    <height>620</height>
   </rect>
  </property>
  <!-- This used to declare 640x750 and mean neither number: with the tab
       pages laid out directly, the dialog's minimumSizeHint was 828x1089
       and Qt silently grew the window to it, which is how the Run and
       Close buttons ended up below the bottom of a laptop screen. The
       pages are in QScrollAreas now, so these values are real.

       Height clears an 800 px panel once the menu bar, the dock and the
       window chrome have taken their cut. Width is the Setup tab's
       natural width (its button grid wants ~800 px), so the default
       opens with no horizontal scrollbar; it is the width the dialog was
       already being forced to. The minimum only has to keep the Run row,
       the tab bar and the button row legible - the scroll areas absorb
       everything else. -->
  <property name="minimumSize">
   <size>
    <width>480</width>
    <height>320</height>
   </size>
  </property>
  <property name="windowTitle">
   <string>Frame</string>
  </property>
  <property name="autoFillBackground">
   <bool>false</bool>
  </property>
  <property name="styleSheet">
   <string notr="true">background-color: rgb(240, 240, 240)</string>
  </property>
